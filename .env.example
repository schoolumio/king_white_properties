# ─────────────────────────────────────────────────────────────────────────────
# Core
# ─────────────────────────────────────────────────────────────────────────────
# Public base URL (used for canonical URLs, sitemap, Open Graph and email links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# PostgreSQL connection string (pooled URL on Vercel/Neon/Supabase)
DATABASE_URL="postgresql://kw:kw@localhost:5432/kw?schema=public"
# Optional: direct (non-pooled) URL used only for running migrations when DATABASE_URL is a pooler.
# DIRECT_URL=""

# Secret used to hash client IPs for rate limiting. Generate with: openssl rand -hex 32
APP_SECRET="change-me-to-a-long-random-string"

# ─────────────────────────────────────────────────────────────────────────────
# Initial super administrator (used only by `npm run db:seed` when no user exists)
# ─────────────────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_NAME="Platform Administrator"
# Minimum 12 characters. Change immediately after first login.
SEED_ADMIN_PASSWORD=""

# ─────────────────────────────────────────────────────────────────────────────
# File storage
#   local      → files on the server disk under ./storage (development / single VM only)
#   cloudinary → Cloudinary (recommended for Vercel). Private documents are stored as
#                "authenticated" assets and are only ever streamed through /api/files/[id]
#                after a permission check.
# ─────────────────────────────────────────────────────────────────────────────
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="enterprise"

# ─────────────────────────────────────────────────────────────────────────────
# Email
#   log    → emails are recorded in the Notification Log only (no delivery)
#   resend → delivered through Resend (https://resend.com)
# Recipients per enquiry category are configured in Admin → Settings → Notifications.
# ─────────────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER="log"
RESEND_API_KEY=""
# Must be an address on a domain verified in Resend, e.g. "Company <noreply@yourdomain.com>"
EMAIL_FROM=""
